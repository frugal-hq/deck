{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Frugal Deck",
  "version": "0.1.0",
  "identifier": "hq.frugal.deck",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../assets/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "both", "installerHooks": "./installer.nsh" }
    }
  }
}
