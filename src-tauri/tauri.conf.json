{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Frugal Deck",
  "version": "0.1.0",
  "identifier": "hq.frugal.deck",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../assets/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "both",
        "template": "./installer/installer.nsi",
        "installerHooks": "./installer.nsh",
        "installerIcon": "../assets/icon.ico",
        "sidebarImage": "./installer/sidebar.bmp",
        "headerImage": "./installer/header.bmp",
        "uninstallerHeaderImage": "./installer/header.bmp",
        "languages": ["English", "Spanish", "Portuguese", "PortugueseBR", "Russian", "Turkish", "French", "German", "Italian", "Japanese", "SimpChinese", "Korean", "Polish", "Ukrainian", "Dutch"],
        "customLanguageFiles": { "Polish": "./installer/Polish.nsh" }
      }
    }
  }
}
